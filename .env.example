# --- AERA configuration (copy to .env and fill in) ---

# REQUIRED: signing secret for authorization tokens (long random string).
AERA_JWT_SECRET=change-me-to-a-long-random-string

# REQUIRED: comma-separated list of authorized research domains.
AERA_DOMAINS=lab.example.com

# REQUIRED: your LLM API key (Z.ai / GLM or compatible endpoint).
AERA_LLM_API_KEY=
# Optional overrides:
# AERA_LLM_BASE_URL=https://api.z.ai/api/paas/v4
# AERA_LLM_MODEL=glm-4.5

# Sandbox on/off (default true).
AERA_SANDBOX_ENABLED=true

# Point these at YOUR lab's vulnerable-app images:
# AERA_IMAGE_WEB=
# AERA_IMAGE_BINARY=
# AERA_IMAGE_NETWORK=

# Audit log location.
AERA_AUDIT_LOG=aera-audit.log

# CISA KEV cache location (default .cache/kev.csv).
# AERA_KEV_CACHE=

# Optional: NVD API key (raises rate limit for heavy batch use).
# AERA_NVD_API_KEY=

# PoC self-healing retries after a failed run (default 1).
# AERA_POC_RETRIES=1
